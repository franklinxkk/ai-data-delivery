  "source": {
    "notice": "仅为合成验收练习；所有人名、企业、记录及规则均为虚构，不代表行业法规、客户制度或真实数据。",
    "paragraphs": {
      "person": "自然人由 person_id 标识；同一自然人可以同时具有学生和教职工角色，角色身份不应复制成两个自然人。",
      "student": "学生角色由 student_id 标识并关联自然人；学籍状态属于角色，不代表自然人失效。",
      "staff": "教职工角色由 staff_id 标识并关联自然人；同一人可兼具在校研究生与任课教师身份。",
      "department": "组织部门用 department_id 标识，改名、合并与人员归属需保留有效期，不以当前部门覆盖历史统计。",
      "term": "学期由 term_id 标识；同名课程在不同学期是不同开课实例。",
      "course": "课程由 course_id 标识；课程名不保证唯一，课程定义与学期开课实例分开。",
      "offering": "开课实例由 offering_id 标识并引用课程和学期；同课程在同学期可开多个教学班。",
      "enrollment": "选课记录由 enrollment_id 标识并关联学生角色和开课实例；同人跨学期重修形成不同选课记录。",
      "room": "教学场地用 room_id 标识；排课占用属于时段记录，不能把教室当前使用者当作所有历史时段使用者。",
      "belongs": "自然人的部门归属带 valid_from 和 valid_to，以统计日读取有效记录；本练习时段采用左闭右开。",
      "teaches": "教职工角色与开课实例的授课关系记录职责和有效时段，不自动授予系统中全校成绩访问权限。",
      "headcount": "人数按指定学期的有效选课记录去重自然人 person_id；重修或多个角色不会增加自然人数。",
      "attempts": "人次数按指定统计期的有效选课 enrollment_id 计数；同一人重修可产生多个人次，区别于自然人数。",
      "grades": "成绩可见范围应由学校系统根据角色、任课关系和数据范围校验；本练习未提供跨院系访客访问规则。"
    }
  },
