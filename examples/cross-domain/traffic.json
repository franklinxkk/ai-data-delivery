    "scenario": "synthetic"
  },
  "source": {
    "notice": "仅为合成验收练习；所有人名、企业、记录及规则均为虚构，不代表行业法规、客户制度或真实数据。 交通模型适用于租户 A（展示名“演练运输企业甲”）；租户 B 的一行观察记录仅用于跨租户误计的反例，不属于 A 的业务范围。",
    "paragraphs": {
      "person": "自然人用 person_id 标识；同一人可在不同时段受雇于不同企业，不把手机号或姓名作为稳定身份。",
      "vehicle": "车辆用 vehicle_id 标识；车牌展示值可能变更，车辆身份不以车牌作为唯一依据。",
      "enterprise": "运输企业是承运或用工主体；车辆所有者、承运企业和驾驶员雇主不保证是同一企业。",
      "route": "线路由 route_id 标识；线路可经过多个场地，同一场地可服务多条线路。",
      "site": "场地由 site_id 标识；一个场地可作为线路始发站、途经站或终点站，角色属于线路与场地的关联。",
      "hazard": "隐患是一项已观察到的不符合要求或不安全状态；关闭隐患表示该项整改完成，不表示相关风险已消失。",
      "risk": "风险是风险事件发生的可能性与后果的评估对象；风险可关联多个隐患，不能用隐患条数代替风险等级。",
      "trip": "来源行程唯一身份是 tenant_id、source_system、original_trip_no 三元组；保留 original_trip_no 展示；两系统同号行程先视为两个来源记录，除非另有已核实的业务关联。",
      "employed": "自然人与运输企业之间的任职关系带 valid_from、valid_to；本练习任职时段为左闭右开，valid_to 缺省表示尚未记录终止；不能把现任雇主套用到历史行程。",
      "drives": "驾驶关系关联自然人与来源行程，驾驶角色不自动推出车辆所有权或雇佣关系。",
      "runs": "来源行程通过明确 route_id 引用线路；相同原行程编号不能跨来源推定同一线路。",
      "visits": "线路与场地关联存储 stop_order 与 role，允许线路和场地多对多；同一场地两次停靠以不同 stop_order 区分。",
      "exposes": "一个风险可关联多项隐患，一项隐患也可关联多个风险；关闭隐患不自动将风险级别清零。",
      "responsibility": "核对行程责任时分别读取承运主体、车辆所有者及行程发生时有效的驾驶员任职；责任结论由本练习业务责任规则判断，外键只证明引用。",
      "trip_count": "来源行程数按租户、来源系统与原行程编号去重；同来源重复采集只计一次，不跨来源自动合并。",
      "risk_review": "风险复评需要明确评估方法与最新评估记录；本练习未提供由隐患整改推导新风险等级的算法。",
      "legacy_rule": "本练习历史任职口径只适用于 2026 年上半年；对下半年不得沿用本版本，需要核对新版本。"
    }
  },
