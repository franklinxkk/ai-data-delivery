  "source": {
    "notice": "仅为合成验收练习；所有人名、企业、记录及规则均为虚构，不代表行业法规、客户制度或真实数据。",
    "paragraphs": {
      "party": "业务主体由 party_id 标识；借款人、账户持有人与担保人为不同角色，同一主体可具有多种角色。",
      "account": "账户以机构代码与 account_id 形成唯一身份；账户是记账载体，不等同于持有人或借款合同。",
      "contract": "借款合同由 contract_id 标识，需保留借款主体、合同币种以及基准日的本金余额；币种不同的余额不直接相加。",
      "collateral": "担保物由 collateral_id 标识；同一担保物可对应多份合同，一份合同也可有多项担保，不能因连接担保重复计算合同余额。",
      "secures": "合同与担保物为多对多关系，关联记录约定的担保范围与份额；关联本身不证明可直接从余额扣除全部评估值。",
      "holds": "业务主体持有账户，允许联名持有；持有关系不自动授予读取账户交易的技术权限。",
      "fx": "跨币种折算需明确目标币种、汇率来源、基准日与报价方向；本练习未提供实际汇率，不能按 1:1 或记忆中的汇率补齐。",
      "gross": "合同本金余额是同一基准日、同一币种的合同余额之和，按 contract_id 去重后汇总；两份不同合同余额相同仍都要计入，不能用 SUM(DISTINCT amount) 替代合同去重。",
      "converted": "折算本金余额将每个合同基准日原币余额按同日可用报价转换到指定目标币种后汇总，汇率缺失则不出完整合计。",
      "risk": "风险敞口的定义取决于业务口径；本练习只明确合同本金余额，未给定净额结算、担保折扣及表外承诺转换规则，不能把本金余额直接标记为监管风险敞口。",
      "access": "读取账户明细须由目标系统验证当前主体的授权、用途和数据范围；本体中的持有或审核角色定义本身不提供访问授权。"
    }
  },
