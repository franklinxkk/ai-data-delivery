  "source": {
    "notice": "仅为合成验收练习；所有人名、企业、记录及规则均为虚构，不代表行业法规、客户制度或真实数据。",
    "paragraphs": {
      "plot": "地块用 plot_id 标识；土地边界调整形成新的边界版本，历史种植季仍引用当时版本。",
      "season": "种植季记录地块版本、作物与起止时间，同一地块跨季不能把产量混入同一生产周期。",
      "batch": "产品批次用 batch_id 标识；混采可汇入同一批次，拆批产生新批次 ID，不能仅用当前批次编号覆盖上游来源。",
      "input": "投入品按 product_id 标识，实际施用记录还需批号、数量、单位、地块与施用时间。",
      "sensor": "传感器由 sensor_id 标识；读数必须保留测点、时间与单位，设备变更不改写历史读数来源。",
      "harvest": "采收来源连接种植季与产品批次，并记录数量及单位；多季混采要保留各来源贡献量。",
      "lineage": "批次流转连接父批次和子批次，记录实际转移质量；混合和拆分都保留独立关联，允许多对多，不以复制整批质量作为每个分支的质量。",
      "applied": "地块的施用记录关联投入品并记录时间、数量和单位；作物许可、间隔期与剂量阈值必须来自适用依据，不能按名称猜测。",
      "monitors": "传感器与地块建立带生效时段的测点绑定；解除后不覆盖历史读数归属。",
      "threshold": "灌溉告警需按作物、种植阶段、土壤类型和测量单位确定阈值；本练习没有给定阈值。",
      "yield": "季产量按地块边界版本与种植季汇总实际采收 kg；流转与拆批记录不重复累计为新产量。",
      "trace": "追溯一批产品需沿批次流转逆向找到采收来源与种植季，分别报告各来源贡献；未知的混合比例不能假设平均分摊。"
    }
  },
